#:import max builtins.max
#:import dp kivy.metrics.dp

<PainelAzul>:
    canvas.before:
        Color:
            rgba: 26/255.0, 126/255.0, 251/255.0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: 'Dados aparecerão aqui'
        font_size: '16sp'
        italic: True
        color: 1, 1, 1, 0.75
        opacity: 1 if root.vazio else 0
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    ScrollView:
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        do_scroll_x: False
        do_scroll_y: True
        bar_width: '6dp'
        scroll_type: ['bars', 'content']

        BoxLayout:
            id: conteudo
            orientation: 'vertical'
            size_hint_y: None
            height: max(self.minimum_height, root.height)
            spacing: '10dp'
            padding: [dp(32) * app.escala_texto, dp(28)]