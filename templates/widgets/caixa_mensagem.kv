#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp

<CaixaMensagem>:
    size_hint: None, None
    size: min(dp(380), Window.width * 0.9), dp(220)
    auto_dismiss: False
    title_color: 0.05, 0.10, 0.25, 1
    title_size: '16sp'
    background: ''
    background_color: 1, 1, 1, 1
    separator_color: (0.10, 0.55, 0.20, 1) if root.tipo == 'sucesso' else ((0.90, 0.60, 0.05, 1) if root.tipo == 'aviso' else (0.80, 0.10, 0.10, 1))
    overlay_color: 0.05, 0.10, 0.25, 0.45

    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(14)

        Label:
            text: root.texto
            color: 0.05, 0.10, 0.25, 1
            font_size: '15sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        Button:
            text: 'OK'
            bold: True
            size_hint_y: None
            height: dp(44)
            background_normal: ''
            background_color: (0.10, 0.55, 0.20, 1) if root.tipo == 'sucesso' else ((0.90, 0.60, 0.05, 1) if root.tipo == 'aviso' else (0.80, 0.10, 0.10, 1))
            color: 1, 1, 1, 1
            on_release: root.dismiss()