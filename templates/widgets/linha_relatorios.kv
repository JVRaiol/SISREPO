#:import dp kivy.metrics.dp

<LinhaRelatorios>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '56dp'
    padding: ['14dp', '8dp', '8dp', '8dp']
    spacing: '10dp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 12
            width: dp(1.5)

    Label:
        id: data_relatorio
        text: root.data
        font_size: '15sp'
        bold: True
        color: 0, 0, 0, 1
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
    
    Label:
        id: turno_relatorio
        text: root.turno
        font_size: '15sp'
        bold: True
        color: 0, 0, 0, 1
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
    
    Label:
        id: id_relatorio
        text: root.texto_id
        font_size: '15sp'
        bold: True
        color: 0, 0, 0, 1
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'

    BotaoVer:
        pos_hint: {'center_y': 0.5}
        on_release: root.ver()