#:import dp kivy.metrics.dp

<OpcaoPagamento>:
    orientation: 'horizontal'
    spacing: dp(6)
    padding: [dp(8), dp(4)]
    size_hint_y: None
    height: dp(40)
    canvas.before:
        Color:
            rgba: (0.05, 0.40, 0.70, 0.18) if self.ativo else (0.88, 0.88, 0.88, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: (0.10, 0.55, 0.90, 1) if self.ativo else (0.65, 0.65, 0.65, 1)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 8
            width: 1.5