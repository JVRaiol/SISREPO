#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp

<CaixaAssistente>:
    size_hint: None, None
    size: min(dp(480), Window.width * 0.92), min(dp(380), Window.height * 0.9)
    auto_dismiss: False
    title_color: 0.05, 0.10, 0.25, 1
    title_size: '16sp'
    background: ''
    background_color: 1, 1, 1, 1
    separator_color: (0.80, 0.10, 0.10, 1) if root.critico else (0.10, 0.45, 0.90, 1)
    overlay_color: 0.05, 0.10, 0.25, 0.45

    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(14)

        ScrollView:
            do_scroll_x: False
            bar_width: dp(5)

            Label:
                text: root.texto
                color: 0.05, 0.10, 0.25, 1
                font_size: '15sp'
                halign: 'left'
                valign: 'top'
                size_hint_y: None
                text_size: self.width, None
                height: self.texture_size[1]

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)

            Button:
                text: 'Cancelar'
                bold: True
                background_normal: ''
                background_color: 0.75, 0.75, 0.75, 1
                color: 0.1, 0.1, 0.1, 1
                on_release: root.cancelar()

            Button:
                text: root.texto_botao
                bold: True
                background_normal: ''
                background_color: (0.80, 0.10, 0.10, 1) if root.critico else (0.10, 0.45, 0.90, 1)
                color: 1, 1, 1, 1
                on_release: root.confirmar()