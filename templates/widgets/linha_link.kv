<LinhaLink>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '34dp'
    spacing: '8dp'

    Label:
        text: root.rotulo
        font_size: root.font_rotulo if root.font_rotulo else '14sp'
        color: root.cor_rotulo if root.cor_rotulo else [0.85, 0.92, 1, 1]
        size_hint_x: None
        width: '190dp'
        bold: root.negrito_rotulo
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    LinkPainel:
        text: root.valor
        font_size: root.font_link
        bold: root.negrito_link
        underline: True
        on_release: root.dispatch('on_abrir')
        color: root.cor_link if root.cor_link else ((1, 1, 1, 1) if (self.hovered or self.state == 'down') else (0.70, 0.88, 1, 1))

<LinkPainel>:
    markup: False
    text_size: self.size
    halign: 'left'
    valign: 'middle'
    shorten: True
    shorten_from: 'right'