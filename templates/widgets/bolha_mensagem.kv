#:import dp kivy.metrics.dp

<BolhaMensagem>:
    size_hint_y: None
    height: balao.height + dp(6)

    Label:
        id: balao
        text: root.texto
        size_hint: None, None
        text_size: min(root.largura_texto, max(dp(60), root.width * 0.75 - dp(28))), None
        width: self.texture_size[0] + dp(28)
        height: self.texture_size[1] + dp(20)
        font_size: '15sp'
        halign: 'left'
        valign: 'middle'
        color: (1, 1, 1, 1) if root.autor == 'usuario' else (0.05, 0.10, 0.25, 1)
        pos_hint: {'right': 1, 'center_y': 0.5} if root.autor == 'usuario' else {'x': 0, 'center_y': 0.5}
        canvas.before:
            Color:
                rgba: (26/255.0, 126/255.0, 251/255.0, 1) if root.autor == 'usuario' else (1, 1, 1, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14]