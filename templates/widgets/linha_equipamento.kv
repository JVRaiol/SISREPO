<LinhaEquipamento>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '56dp'
    padding: ['14dp', '8dp', '8dp', '8dp']
    spacing: '10dp'
    canvas.before:
        Color:
            rgba: (0.30, 0.34, 0.42, 1) if self.pausado else (0.05, 0.10, 0.25, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

    Label:
        text: root.nome
        font_size: '15sp'
        bold: True
        color: (0.75, 0.78, 0.85, 1) if root.pausado else (1, 1, 1, 1)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'

    Label:
        text: 'Pausado'
        font_size: '12sp'
        bold: True
        color: 0.90, 0.60, 0.05, 1
        opacity: 1 if root.pausado else 0
        size_hint_x: None
        width: '70dp' if root.pausado else '0dp'

    BotaoTresPontinhos:
        pos_hint: {'center_y': 0.5}
        on_release: root.abrir_menu(self)