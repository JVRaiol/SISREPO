#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window
#:import max builtins.max
#:import min builtins.min

<ItemMenu>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '50dp'
    spacing: '10dp'
    padding: [5, 0, 5, 5]

    ImageButtonMenu:
        source: root.icone
        size_hint: None, None
        size: max(dp(45), min(dp(60), Window.width * 0.04)), max(dp(45), min(dp(60), Window.width * 0.04))
        allow_stretch: True
        keep_ratio: True
        pos_hint: {'center_y': 0.5}
        on_release: root.dispatch('on_release')

    Label:
        text: root.texto
        opacity: max(0, (root.progresso - 0.6) / 0.4)
        font_size: '16sp'
        color: 0, 0, 0, 1
        size_hint_x: None
        width: '120dp'
        text_size: self.size
        valign: 'middle'
        halign: 'left'