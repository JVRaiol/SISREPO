<BarraProgresso>:
    canvas:
        Color:
            rgba: 0.05, 0.10, 0.25, 0.12
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: 0.05, 0.35, 0.75, 1
        RoundedRectangle:
            pos: self.pos
            size: self.width * self.valor / 100.0, self.height
            radius: [self.height / 2]