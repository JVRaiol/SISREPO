<LinhaEdicao>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '44dp'
    spacing: '8dp'

    Label:
        text: root.rotulo
        font_size: '14sp'
        color: 0.85, 0.92, 1, 1
        size_hint_x: None
        width: '190dp'
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    CampoInput:
        id: campo
        text: root.valor
        input_filter: 'int' if root.numerico else None