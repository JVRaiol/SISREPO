#:import CoreLabel kivy.core.text.Label
#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<SeletorFiltro>:
    option_cls: 'OpcaoSeletor'
    size_hint_y: None
    height: '34dp'
    pos_hint: {'center_y': 0.5}
    background_normal: ''
    background_down: ''
    background_color: 1, 1, 1, 1
    color: 0, 0, 0, 1
    halign: 'left'
    valign: 'middle'
    text_size: self.width - dp(20), self.height
    shorten: True
    font_size: sp(15) * min(1, max(0.7, Window.width / 1000.0)) * min(1, (self.width - dp(24)) / max(1, CoreLabel(text=self.text, font_size=sp(15), font_name=self.font_name).get_extents(self.text)[0]))