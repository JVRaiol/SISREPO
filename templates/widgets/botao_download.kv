#:import dp kivy.metrics.dp

<BotaoDownload>:
    size_hint: None, None
    width: '36dp'
    height: '36dp'
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.35) if self.state == 'down' else ((1, 1, 1, 0.20) if self.hovered else (0, 0, 0, 0))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18]
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        # Linha/Barra horizontal da base (base do símbolo de download)
        Line:
            points: 
                [
                self.center_x - dp(7), self.center_y - dp(8),
                self.center_x + dp(7), self.center_y - dp(8)
                ]
            width: dp(1.5)
            cap: 'round'
        # Seta vertical apontando para baixo (haste)
        Line:
            points: 
                [
                self.center_x, self.center_y + dp(7),
                self.center_x, self.center_y - dp(4)
                ]
            width: dp(1.5)
            cap: 'round'
        # Pontas da seta (diagonal esquerda e diagonal direita)
        Line:
            points: 
                [
                self.center_x - dp(4.5), self.center_y + dp(1.5),
                self.center_x, self.center_y - dp(3.5),
                self.center_x + dp(4.5), self.center_y + dp(1.5)
                ]
            width: dp(1.5)
            cap: 'round'
            joint: 'round'