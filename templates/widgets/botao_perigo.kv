<BotaoPerigo>:
    color: 1, 1, 1, 1

    canvas.before:
        Color:
            rgba: (0.60, 0.05, 0.05, 1) if self.state == 'down' else ((0.85, 0.12, 0.12, 1) if self.hovered else (0.75, 0.08, 0.08, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]